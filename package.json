{
  "name": "bruno-capture",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @bruno-capture/server run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "workflows:validate": "pnpm --filter @bruno-capture/cli run start -- workflows validate"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
